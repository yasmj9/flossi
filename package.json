{
  "name": "flossi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"NEST,NEXT\" -c \"blue,green\" \"PORT=3001 npx tsx --tsconfig api/tsconfig.json api/src/main.ts\" \"npx next dev client -p 3000 --turbopack\"",
    "build": "npm --prefix api run build && npx next build client",
    "start": "concurrently -k -p \"[{name}]\" -n \"NEST,NEXT\" -c \"blue,green\" \"node api/dist/main.js\" \"npx next start client -p 3000\"",
    "test": "npx tsx client/lib/financialMath.test.ts && npx tsx client/lib/shariahScreening.test.ts && npx tsx client/lib/decisionsEngine.test.ts",
    "lint": "npx eslint client"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
